    <mediaobject>
      <imageobject>
        <imagedata fileref="aqbanking-user-wizard-paypal-page5.png"/>
      </imageobject>
    </mediaobject>
  </screenshot>
</sect3>
<sect3 id="paypal_setup_password">
  <title
>أدخل كلمة سر جديدة لمستخدم باي بال</title>
  <screenshot>
    <screeninfo
></screeninfo>
    <mediaobject>
